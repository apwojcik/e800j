
#kompilacja dla Windows
WIN32_SUPPORT = no

#kompilator
CC = gcc

# nazwa programu wynikowego
EMULATOR_NAME =elwro

# za³±cza kompilacjê z GTK 2.0 zamiast GTK 1.2
LIB_GTK20 = yes

# Opcja ta za³±cza wsparcie dla SDL
LIB_SDL = yes

# Opcja ta za³±cza obs³ugê snapshot-ów przez libspectrum
LIB_SPECTRUM = yes

# Ustawia zachowanie siê CPU po za³adowaniu snapshota, jesli "yes" wówczas jest uruchamiany
# inaczej CPU jest stanie pauzy
RUN_SNAPSHOT = no

# Za³±czenie kodu debuggera Z80
Z80_DEBUGGER = yes

# Flagi optymalizacji (wy³acza profiler i gdb)
OPTIMALIZATION = -O3 -fomit-frame-pointer

# Flagi kompilatora dodawane zawsze do kompilacji wszystkich plików plików *.c
ALL_OPTION = -Wall

#Za³±cza do kodu informacje dla gdb, oraz wy³±cza optymalizacjê
DEBUG_GDB = yes

#Za³±cza profiler
PROFILER = no

